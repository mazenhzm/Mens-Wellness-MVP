# DATABASE_URL is supplied by the Replit PostgreSQL database.
DATABASE_URL=

# Configure through Replit Secrets; never commit a real value.
SESSION_SECRET=
CLERK_SECRET_KEY=

# Development may use the local Redis workflow. Production needs a managed Redis URL.
REDIS_URL=

DEBUG=false
ALLOWED_HOSTS=

# Optional: Clerk PEM public key for local JWT verification. If omitted,
# clerk-backend-api retrieves and caches the instance JWKS using CLERK_SECRET_KEY.
CLERK_JWT_KEY=

# Comma-separated authorized parties when the token includes an azp claim.
CLERK_AUTHORIZED_PARTIES=
